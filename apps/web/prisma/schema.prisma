datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

generator client {
  provider = "prisma-client-js"
}

model User {
  id          String       @id @default(cuid())
  address     String       @unique
  displayName String?
  createdAt   DateTime     @default(now())
  picks       Pick[]
  scores      EventScore[]
}

model AuthNonce {
  nonce     String    @id
  expiresAt DateTime
  usedAt    DateTime?
}

model Event {
  id              String       @id @default(cuid())
  slug            String       @unique
  title           String
  hostName        String
  sponsorName     String?
  sponsorLogoUrl  String?
  sponsorUrl      String?
  prizeText       String?
  bossLevel       Int
  maxCrowdMoves   Int
  startsAt        DateTime
  status          String       @default("SCHEDULED") // SCHEDULED | LIVE | FINISHED | ABANDONED
  result          String? // WIN | SURVIVED | LOST
  fen             String
  crowdMoveNumber Int          @default(0)
  emptyTurnStreak Int          @default(0)
  isPractice      Boolean      @default(false)
  createdAt       DateTime     @default(now())
  finishedAt      DateTime?
  turns           Turn[]
  scores          EventScore[]

  @@index([isPractice, createdAt])
  @@index([status, startsAt])
}

model Turn {
  id           String    @id @default(cuid())
  eventId      String
  event        Event     @relation(fields: [eventId], references: [id], onDelete: Cascade)
  number       Int
  status       String    @default("OPEN") // OPEN | RESOLVING | RESOLVED
  claimedAt    DateTime?
  opensAt      DateTime
  endsAt       DateTime
  fenBefore    String
  candidates   Json
  chosenUci    String?
  crowdSan     String?
  bossReplyUci String?
  bossReplySan String?
  fenAfter     String?
  resolvedAt   DateTime?

  @@unique([eventId, number])
}

model Pick {
  id         String   @id @default(cuid())
  eventId    String
  turnNumber Int
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  uci        String
  points     Int?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @default(now())

  @@unique([eventId, turnNumber, userId])
  @@index([userId])
}

model EventScore {
  eventId      String
  event        Event     @relation(fields: [eventId], references: [id], onDelete: Cascade)
  userId       String
  user         User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  turnsPicked  Int       @default(0)
  points       Int       @default(0)
  bonus        Int       @default(0)
  disqualified Boolean   @default(false)
  prizePaidAt  DateTime?

  @@id([eventId, userId])
  @@index([eventId, points])
  @@index([userId])
}

model Lead {
  id           String    @id @default(cuid())
  type         String // SPONSOR | CREATOR
  name         String
  contact      String
  organization String?
  message      String
  createdAt    DateTime  @default(now())
  handledAt    DateTime?
}
