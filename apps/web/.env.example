# Pooled Postgres connection (Neon pooler URL on Vercel).
DATABASE_URL=postgresql://user:password@localhost:5432/pawnpool
# Direct (non-pooled) connection, used for migrations.
DIRECT_URL=postgresql://user:password@localhost:5432/pawnpool
# Secret that signs session cookies, at least 32 random characters.
SESSION_SECRET=replace-with-at-least-32-random-characters
# Comma-separated wallet addresses allowed into /admin.
ADMIN_ADDRESSES=0x0000000000000000000000000000000000000000
# Optional: WalletConnect project id for the wallet modal.
NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=
# Secret that protects /api/cron (Vercel sends it as a bearer token).
CRON_SECRET=replace-with-a-random-string
# Optional: public site URL, defaults to https://pawnpool.rahmateka.my.id.
NEXT_PUBLIC_SITE_URL=
# Tests only: database used by the integration tests.
TEST_DATABASE_URL=postgresql://postgres:pp@localhost:5544/postgres
