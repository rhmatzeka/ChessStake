# Pooled Postgres connection (Neon pooler URL on Vercel). On Neon it must end with
# ?pgbouncer=true&connect_timeout=15 (use &pgbouncer=true&connect_timeout=15 when the URL
# already has a query string, such as ?sslmode=require).
DATABASE_URL=postgresql://user:password@localhost:5432/pawnpool
# Direct (non-pooled) connection, used for migrations. Required in every environment
# because the build runs prisma migrate deploy whenever DATABASE_URL is set.
DIRECT_URL=postgresql://user:password@localhost:5432/pawnpool
# Secret that signs session cookies, at least 32 random characters.
SESSION_SECRET=replace-with-at-least-32-random-characters
# Comma-separated wallet addresses allowed into /admin (leave empty to disable the admin).
ADMIN_ADDRESSES=
# Privy app id (dashboard.privy.io) for the login sheet: email, Google and wallets. Sign-in is off without it.
NEXT_PUBLIC_PRIVY_APP_ID=
# Secret that protects /api/cron (Vercel sends it as a bearer token).
CRON_SECRET=replace-with-a-random-string
# Optional: public site URL, defaults to https://pawnpool.rahmateka.my.id.
NEXT_PUBLIC_SITE_URL=
# Tests only: database used by the integration tests.
TEST_DATABASE_URL=postgresql://postgres:pp@localhost:5544/postgres
